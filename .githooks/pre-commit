#!/bin/sh
# Refuse le commit si un test échoue (activé par : git config core.hooksPath .githooks).
# Pour passer outre exceptionnellement : git commit --no-verify
cd "$(git rev-parse --show-toplevel)" || exit 1
if [ -x .venv/Scripts/python.exe ]; then PY=.venv/Scripts/python.exe; else PY=.venv/bin/python; fi
echo "Tests avant commit…"
"$PY" -m pytest -q -p no:warnings tests || { echo "Tests en échec : commit refusé."; exit 1; }
